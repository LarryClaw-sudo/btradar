def audit_gatt_security(services_data):
    """Audit GATT services for security concerns.

    Args:
        services_data: List of dicts with keys: uuid, name, chars (list of dicts with uuid, name, properties, value)

    Returns:
        Tuple of (findings, score) where findings is a list of (severity, text) tuples
        and score is a letter grade: A, B, C, D, or F.
    """
    findings = []

    for svc in services_data:
        svc_uuid_lower = svc["uuid"].lower()
        svc_name = svc.get("name", "") or ""

        # Check for known debug services
        if svc_uuid_lower in _DEBUG_SERVICES:
            debug_name = _DEBUG_SERVICES[svc_uuid_lower]
            if "dfu" in debug_name.lower() or "oad" in debug_name.lower():
                findings.append(("critical", f"Debug/DFU service detected: {debug_name} ({svc['uuid']})"))
            else:
                findings.append(("info", f"Standard service: {debug_name} ({svc['uuid']})"))

        # Check for Device Information service with exposed identifiers
        if svc_uuid_lower == "0000180a-0000-1000-8000-00805f9b34fb":
            for ch in svc.get("chars", []):
                ch_uuid_lower = ch["uuid"].lower()
                if ch_uuid_lower in ("00002a25-0000-1000-8000-00805f9b34fb",
                                     "00002a23-0000-1000-8000-00805f9b34fb"):
                    findings.append(("warning", f"Exposed device identifier: {ch.get('name', ch['uuid'])} in Device Information"))

        # Check for Heart Rate service (health data)
        if svc_uuid_lower == "0000180d-0000-1000-8000-00805f9b34fb":
            findings.append(("info", "Heart Rate service detected — health data may be exposed"))

        for ch in svc.get("chars", []):
            props = ch.get("properties", [])
            props_lower = [p.lower() for p in props]
            ch_uuid_lower = ch["uuid"].lower()

            # WRITE without authentication
            if "write" in props_lower and "write-without-response" not in props_lower:
                if "authenticated-w" not in props_lower and "authenticated-write" not in props_lower:
                    findings.append(("warning",
                        f"Characteristic {ch.get('name') or ch['uuid']} supports WRITE without authentication requirement"))

            # WRITE-WITHOUT-RESPONSE (dangerous — no confirmation)
            if "write-without-response" in props_lower:
                findings.append(("warning",
                    f"Characteristic {ch.get('name') or ch['uuid']} supports WRITE-WITHOUT-RESPONSE (no confirmation)"))

            # NOTIFY/INDICATE without authentication
            if ("notify" in props_lower or "indicate" in props_lower):
                if "authenticated-r" not in props_lower and "authenticated-indicate" not in props_lower:
                    # Only flag if it's not a standard well-known service
                    if svc_uuid_lower not in (
                        "0000180d-0000-1000-8000-00805f9b34fb",  # Heart Rate
                        "0000180f-0000-1000-8000-00805f9b34fb",  # Battery
                        "00001800-0000-1000-8000-00805f9b34fb",  # Generic Access
                        "00001801-0000-1000-8000-00805f9b34fb",  # Generic Attribute
                    ):
                        findings.append(("info",
                            f"Characteristic {ch.get('name') or ch['uuid']} has NOTIFY/INDICATE without authentication"))

            # Known debug characteristics
            if ch_uuid_lower in _DEBUG_CHARS:
                debug_ch_name = _DEBUG_CHARS[ch_uuid_lower]
                if "dfu" in debug_ch_name.lower() or "oad" in debug_ch_name.lower():
                    findings.append(("critical", f"Debug characteristic: {debug_ch_name} ({ch['uuid']})"))
                elif ch_uuid_lower in ("00002a25-0000-1000-8000-00805f9b34fb",
                                        "00002a23-0000-1000-8000-00805f9b34fb"):
                    findings.append(("warning", f"Exposed identifier: {debug_ch_name} ({ch['uuid']})"))

    # Compute grade
    critical_count = sum(1 for s, _ in findings if s == "critical")
    warning_count = sum(1 for s, _ in findings if s == "warning")
    info_count = sum(1 for s, _ in findings if s == "info")

    if critical_count > 0:
        score = "F"
    elif warning_count >= 3:
        score = "D"
    elif warning_count >= 1:
        score = "C"
    elif info_count >= 2:
        score = "B"
    else:
        score = "A"

    return findings, score



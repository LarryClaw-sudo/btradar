def main():
    ap = argparse.ArgumentParser(
        prog="btradar",
        description="\U0001f4e1 Unified Bluetooth scanner TUI for macOS",
    )

    ap.add_argument(
        "--version", action="version", version=f"%(prog)s {__version__}"
    )
    ap.add_argument(
        "-t",
        "--time",
        type=int,
        default=10,
        help="Scan duration in seconds (default 10 for TUI, 15 for scan)",
    )
    ap.add_argument(
        "-b",
        "--ble",
        dest="mode",
        action="store_const",
        const="ble",
        help="BLE only",
    )
    ap.add_argument(
        "-c",
        "--classic",
        dest="mode",
        action="store_const",
        const="classic",
        help="Classic BT only",
    )
    ap.add_argument("--offline", action="store_true", help="Skip online vendor lookup fallback")
    ap.add_argument(
        "--refresh-oui",
        action="store_true",
        help="Re-download IEEE OUI vendor database",
    )
    ap.add_argument("--lookup", metavar="MAC", help="Resolve one MAC address and exit")
    ap.add_argument(
        "--json", "-j", action="store_true", help="JSON output (one-shot)"
    )
    ap.add_argument(
        "--refresh",
        type=int,
        default=3,
        help="TUI refresh interval in seconds (default 3)",
    )

    sub = ap.add_subparsers(dest="command")

    # btradar scan
    scan_p = sub.add_parser("scan", help="One-shot scan, print table, exit")
    scan_p.add_argument(
        "-t", "--time", type=int, default=15, help="Scan seconds (default 15)"
    )
    scan_p.add_argument(
        "-b", "--ble", dest="mode", action="store_const", const="ble"
    )
    scan_p.add_argument(
        "-c", "--classic", dest="mode", action="store_const", const="classic"
    )
    scan_p.add_argument("--offline", action="store_true")
    scan_p.add_argument("--json", "-j", action="store_true")

    # btradar update
    sub.add_parser("update", help="Download and install the latest btradar")

    # btradar help [TOPIC]
    help_p = sub.add_parser("help", help="Show help topics or search for a keyword")
    help_p.add_argument("topic", nargs="?", default=None, help="Search for this keyword")
    help_p.add_argument(
        "--list", dest="list_topics", action="store_true",
        help="Show all topic headers (same as bare help)"
    )

    args = ap.parse_args()

    # Refresh OUI
    if args.refresh_oui:
        load_oui(refresh=True)
        print("\u2705  OUI database refreshed.")
        return

    # Lookup one address
    if args.lookup:
        lookup_one(args.lookup, online=not args.offline)
        return

    # Help command
    if args.command == "help":
        if args.topic:
            search_help(args.topic)
        else:
            show_help_topics()
        return

    # Update
    if args.command == "update":
        import shutil
        url = "https://raw.githubusercontent.com/LarryClaw-sudo/btradar/main/btradar"
        target = os.path.abspath(sys.argv[0])
        print(f"Downloading latest btradar from {url}...")
        try:
            import urllib.request
            urllib.request.urlretrieve(url, target + ".new")
            os.chmod(target + ".new", 0o755)
            shutil.move(target + ".new", target)
            print(f"Updated! Restart btradar to use the new version.")
        except Exception as e:
            print(f"Update failed: {e}")
            print(f"You can also manually download from: {url}")
        return

    # Determine scan mode
    classic_only = args.mode == "classic"
    ble_only = args.mode == "ble"

    if args.command == "scan":
        sec = args.time
        if args.json:
            json_output(sec, sec, classic_only, ble_only)
        else:
            one_shot_table(sec, sec, classic_only, ble_only)
        return

    # Default: TUI mode — check Bluetooth first
    available, bt_msg = check_bluetooth_available()
    if not available:
        from rich.console import Console
        console = Console()
        console.print(f"\n[bold yellow]\u26a0  {bt_msg}[/bold yellow]")
        console.print(
            "[dim]Cannot start Bluetooth scanner. "
            "Showing help instead.[/dim]\n"
        )
        show_help_topics()
        return

    sec = args.time
    BTRadarApp = _build_tui()
    app = BTRadarApp(
        classic_sec=sec,
        ble_sec=sec,
        classic_only=classic_only,
        ble_only=ble_only,
    )
    app.run()


if __name__ == "__main__":
    main()


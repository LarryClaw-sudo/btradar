# ║  SQLite History Database                                        ║
# ╚══════════════════════════════════════════════════════════════════╝

HISTORY_DB_DIR = os.path.expanduser("~/.btradar")
HISTORY_DB = os.path.join(HISTORY_DB_DIR, "history.db")


def init_history_db():
    """Create history database and tables if they don't exist."""
    os.makedirs(HISTORY_DB_DIR, exist_ok=True)
    conn = sqlite3.connect(HISTORY_DB)
    c = conn.cursor()
    c.execute("""CREATE TABLE IF NOT EXISTS devices (
        id TEXT PRIMARY KEY,
        name TEXT,
        vendor TEXT,
        address TEXT,
        type TEXT,
        first_seen TEXT,
        last_seen TEXT,
        last_rssi INTEGER,
        apple_identity TEXT
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS events (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        device_id TEXT,
        timestamp TEXT,
        rssi INTEGER,
        apple_identity TEXT,
        raw_manufacturer_data TEXT,
        FOREIGN KEY(device_id) REFERENCES devices(id)
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_events_device ON events(device_id)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_events_timestamp ON events(timestamp)")
    conn.commit()
    conn.close()


def history_record_device(dev):
    """Insert or update a device in history."""
    now = datetime.now().isoformat()
    conn = sqlite3.connect(HISTORY_DB)
    c = conn.cursor()
    c.execute("""INSERT INTO devices (id, name, vendor, address, type, first_seen, last_seen, last_rssi, apple_identity)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
        ON CONFLICT(id) DO UPDATE SET
            name = COALESCE(NULLIF(excluded.name, ''), devices.name),
            vendor = COALESCE(NULLIF(excluded.vendor, ''), devices.vendor),
            address = excluded.address,
            type = excluded.type,
            last_seen = excluded.last_seen,
            last_rssi = excluded.last_rssi,
            apple_identity = COALESCE(NULLIF(excluded.apple_identity, ''), devices.apple_identity)
    """, (
        dev["id"],
        dev.get("name", ""),
        dev.get("vendor", ""),
        dev.get("address", ""),
        dev.get("type", ""),
        now,
        now,
        dev.get("rssi"),
        dev.get("apple_identity", ""),
    ))
    conn.commit()
    conn.close()


def history_record_event(dev):
    """Record a scan event for a device."""
    now = datetime.now().isoformat()
    conn = sqlite3.connect(HISTORY_DB)
    c = conn.cursor()
    c.execute(
        "INSERT INTO events (device_id, timestamp, rssi, apple_identity, raw_manufacturer_data) VALUES (?, ?, ?, ?, ?)",
        (dev["id"], now, dev.get("rssi"), dev.get("apple_identity", ""), ""),
    )
    conn.commit()
    conn.close()


def history_load_devices():
    """Load all devices from history DB."""
    if not os.path.exists(HISTORY_DB):
        return []
    conn = sqlite3.connect(HISTORY_DB)
    c = conn.cursor()
    c.execute(
        "SELECT id, name, vendor, address, type, first_seen, last_seen, last_rssi, apple_identity "
        "FROM devices ORDER BY last_seen DESC"
    )
    rows = c.fetchall()
    conn.close()
    return [
        {
            "id": r[0], "name": r[1], "vendor": r[2], "address": r[3], "type": r[4],
            "first_seen": r[5], "last_seen": r[6], "last_rssi": r[7], "apple_identity": r[8],
        }
        for r in rows
    ]


def history_prune():
    """Delete events older than 30 days."""
    if not os.path.exists(HISTORY_DB):
        return
    conn = sqlite3.connect(HISTORY_DB)
    c = conn.cursor()
    cutoff = (datetime.now() - timedelta(days=30)).isoformat()
    c.execute("DELETE FROM events WHERE timestamp < ?", (cutoff,))
    conn.commit()
    conn.close()


def history_get_event_count(device_id):
    """Get total event count for a device."""
    if not os.path.exists(HISTORY_DB):
        return 0
    conn = sqlite3.connect(HISTORY_DB)
    c = conn.cursor()
    c.execute("SELECT COUNT(*) FROM events WHERE device_id = ?", (device_id,))
    count = c.fetchone()[0]
    conn.close()
    return count


def history_get_events_per_minute(device_id, window_minutes=1):
    """Get events in the last N minutes for a device."""
    if not os.path.exists(HISTORY_DB):
        return 0
    conn = sqlite3.connect(HISTORY_DB)
    c = conn.cursor()
    cutoff = (datetime.now() - timedelta(minutes=window_minutes)).isoformat()
    c.execute("SELECT COUNT(*) FROM events WHERE device_id = ? AND timestamp > ?", (device_id, cutoff))
    count = c.fetchone()[0]
    conn.close()
    return count


def history_get_zone_history(device_id):
    """Get zone history for a device from events."""
    if not os.path.exists(HISTORY_DB):
        return []
    conn = sqlite3.connect(HISTORY_DB)
    c = conn.cursor()
    c.execute("SELECT timestamp, rssi FROM events WHERE device_id = ? ORDER BY timestamp DESC LIMIT 50", (device_id,))
    rows = c.fetchall()
    conn.close()
    zones = []
    for ts, rssi in rows:
        if rssi is not None:
            if rssi > -50:
                zones.append("immediate")
            elif rssi > -60:
                zones.append("near")
            elif rssi > -70:
                zones.append("far")
            else:
                zones.append("remote")
        else:
            zones.append("unknown")
    return zones



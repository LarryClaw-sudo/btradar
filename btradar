# ── Continuity Spam Detection ────────────────────────────────────────
# Known attack signatures in Apple Continuity manufacturer data (0x4C).
# Each maps a hex prefix of the TLV payload to (name, severity).
# Severity: "critical" = potential exploit/dangerous, "warning" = known spam, "info" = nuisance
SPAM_SIGNATURES = {
    "071905": ("Fake AirTag — 'AirTag Found Moving With You' spam", "warning"),
    "071907": ("'Setup New Device' popup spam", "warning"),
    "071901": ("'Not Your Device' popup spam", "warning"),
    "0f05c0": ("Continuity Action Modal popup spam", "warning"),
    "0f0540": ("Action Modal variant spam", "warning"),
    "000010": ("iOS 17 crash exploit (CVE-2023-38539)", "critical"),
    "07190f": ("Fake Apple TV / Apple Watch popup", "warning"),
    "071913": ("Fake Apple Watch variant popup", "warning"),
}


def detect_continuity_spam(manufacturer_data_bytes):
    """Check Apple Continuity manufacturer data against known spam signatures.

    Args:
        manufacturer_data_bytes: Raw manufacturer data bytes (including the
            2-byte Apple company ID prefix).

    Returns:
        List of (signature_name, severity) tuples for any matches.
    """
    matches = []
    if not manufacturer_data_bytes or len(manufacturer_data_bytes) < 2:
        return matches
    # Skip the 2-byte Apple company ID (0x4C, 0x00) prefix
    payload = manufacturer_data_bytes[2:]
    if not payload:
        return matches
    # The payload contains TLVs; check the first few bytes of each
    # sub-payload against known signatures
    i = 0
    n = len(payload)
    while i + 1 < n:
        tlv_type = payload[i]
        tlv_len = payload[i + 1]
        if tlv_len == 0 or i + 2 + tlv_len > n:
            tlv_payload = payload[i + 2:]
        else:
            tlv_payload = payload[i + 2: i + 2 + tlv_len]
        # Check first 3 bytes of this TLV's payload as a hex signature
        if len(tlv_payload) >= 3:
            sig = tlv_payload[:3].hex()
            if sig in SPAM_SIGNATURES:
                matches.append(SPAM_SIGNATURES[sig])
        elif len(tlv_payload) >= 1:
            sig = tlv_payload.hex()
            if sig in SPAM_SIGNATURES:
                matches.append(SPAM_SIGNATURES[sig])
        i += 2 + tlv_len
    return matches


def parse_apple_tlvs(data):
    """Parse Apple manufacturer payload into [(type, bytes)] TLVs."""
    out, i = [], 0
    n = len(data)
    while i + 1 < n:
        t, ln = data[i], data[i + 1]
        if ln == 0 or i + 2 + ln > n:
            out.append((t, data[i + 2:i + 2 + min(ln, max(0, n - i - 2))]))
            break
        out.append((t, bytes(data[i + 2:i + 2 + ln])))
        i += 2 + ln
    return out


def battery_nibble(nib):
    """0..14 -> percentage string, 0 -> None, 15 -> charging."""
    if nib == 0:
        return None
    if nib == 15:
        return "100% (charging)"
    return f"{nib * 100 // 14}%"


def decode_airpods_battery(payload):
    """AirPods proximity-pairing frame: left/right/case battery nibbles."""
    if len(payload) < 3:
        return {}
    b = payload[:8]
    hi = [x >> 4 for x in b]
    lo = [x & 0x0F for x in b]
    left = battery_nibble(hi[0]) if hi[0] else (battery_nibble(lo[0]) if lo[0] else None)
    right = battery_nibble(lo[1]) if len(b) > 1 and lo[1] else None
    case = battery_nibble(lo[2]) if len(b) > 2 and lo[2] else None
    out = {}
    if left:
        out["left"] = left
    if right:
        out["right"] = right
    if case:
        out["case"] = case
    return out


def decode_apple_identity(manufacturer_data):
    """Decode Apple Continuity manufacturer_data into human-readable identity lines.

    Args:
        manufacturer_data: dict[int, bytes] from AdvertisementData
    Returns:
        (primary_label, detail_lines) tuple
    """
    apple_payload = manufacturer_data.get(APPLE_COMPANY_ID)
    if apple_payload is None:
        return None, []

    tlvs = parse_apple_tlvs(bytes(apple_payload))
    identity_parts = []
    detail_lines = []

    for t, payload in tlvs:
        name = APPLE_TYPES.get(t, f"Continuity 0x{t:02X}")
        detail = ""

        if t == 0x02 and len(payload) >= 21:
            u = payload[:16].hex()
            maj = int.from_bytes(payload[16:18], "big")
            mnr = int.from_bytes(payload[18:20], "big")
            txb = payload[20]
            tx = txb - 256 if txb > 127 else txb
            detail = f" UUID={u[:8]}...{u[-4:]} major={maj} minor={mnr} tx={tx:+d}dBm"
            identity_parts.append(name)

        elif t == 0x05 and len(payload) >= 1:
            detail = f" ({len(payload)} bytes, hashed Apple ID)"
            identity_parts.append("AirDrop")

        elif t == 0x10 and len(payload) >= 1:
            code = payload[0] & 0x0F
            sharing = payload[0] >> 4
            action_str = NEARBY_ACTION.get(code, f"code=0x{code:X}")
            detail = f" action={action_str} locationSharing={'on' if sharing else 'off'}"
            identity_parts.append("Nearby")

        elif t in (0x07, 0x0F):
            bat = decode_airpods_battery(payload)
            if bat:
                bat_str = ", ".join(f"{k}={v}" for k, v in bat.items())
                detail = f" battery={bat_str}"
                identity_parts.append("AirPods")
            else:
                detail = " (pairing frame)"
                identity_parts.append("Proximity Pairing")

        elif t in (0x19, 0x12):
            detail = " (Find My network beacon)"
            identity_parts.append("Find My / AirTag")

        elif t == 0x0C:
            identity_parts.append("Handoff")
        elif t == 0x09:
            identity_parts.append("AirPlay Target")
        elif t == 0x0B:
            identity_parts.append("MagSafe")
        elif t == 0x08:
            identity_parts.append("Hey Siri")

        detail_lines.append((APPLE_TYPES.get(t, f"0x{t:02X}"), detail.strip()))

    primary = " + ".join(identity_parts) if identity_parts else "Apple device"
    return primary, detail_lines



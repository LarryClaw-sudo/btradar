def search_help(topic):
    """Search HELP_TEXT for TOPIC and print matching sections with context."""
    from rich.console import Console

    console = Console()
    sections = _parse_sections(HELP_TEXT)
    topic_lower = topic.lower()
    matches = []

    for name, content in sections:
        lines = content.splitlines()
        matched_line_indices = set()
        for i, line in enumerate(lines):
            if topic_lower in line.lower():
                matched_line_indices.add(i)

        if matched_line_indices:
            matches.append((name, lines, matched_line_indices))

    if not matches:
        console.print(f"[dim]No results for '[bold]{topic}[/bold]' in help.[/dim]")
        console.print("[dim]Try: btradar help  (to see all topics)[/dim]")
        return

    for name, lines, matched_indices in matches:
        console.print(f"\n[bold cyan]\u2550\u2550\u2550 {name} \u2550\u2550\u2550[/bold cyan]")

        shown = set()
        for idx in sorted(matched_indices):
            start = max(0, idx - 3)
            end = min(len(lines), idx + 4)
            for i in range(start, end):
                shown.add(i)

        prev = -1
        for i in sorted(shown):
            if i > prev + 1 and prev >= 0:
                console.print("[dim]  ...[/dim]")
            line = lines[i].rstrip()
            if i in matched_indices:
                console.print(f"  [bold yellow]>[/] {line}")
            else:
                console.print(f"    {line}")
            prev = i

    console.print(
        f"\n[dim]  Found {sum(len(mi) for _, _, mi in matches)} match(es) "
        f"in {len(matches)} section(s).[/]"
    )



        BINDINGS = [
            Binding("escape", "close", "Close"),
        ]

        def __init__(self, device):
            super().__init__()
            self.device = device
            self.target_id = device["id"]
            self.log_entries = []
            self._scanner = None
            self._prev_rssi = None
            self._rssi_history = []  # last 5 RSSI readings
            self._graph_data = []  # (timestamp, rssi) for graph, max 120
            self._event_count = 0
            self._first_event_time = None
            self._last_event_time = None
            self._event_times = []  # timestamps for events/minute
            self._spam_count = 0  # session spam event counter

        def compose(self) -> ComposeResult:
            from textual.containers import Vertical
            name = self.device.get("name") or self.device.get("apple_identity") or self.target_id[:12]
            with Vertical(id="log-container"):
                yield Static(f"Action Log: {name}", id="log-title")
                yield Static("Awaiting signal data...", id="rssi-graph")
                yield Static("Waiting for advertisements...", id="log-stats")
                yield Static("", id="log-entries")
                yield Label("[dim]Esc to close | Watching for BLE events from this device[/dim]", id="log-hint")

        def _compute_zone(self, rssi):
            """Classify RSSI into proximity zone."""
            if rssi is None:
                return "unknown"
            if rssi > -50:
                return "immediate"
            elif rssi > -60:
                return "near"
            elif rssi > -70:
                return "far"
            else:
                return "remote"

        def _compute_rssi_trend(self):
            """Moving average of last 5 readings, return (avg, arrow)."""
            if not self._rssi_history:
                return None, ""
            avg = sum(self._rssi_history) / len(self._rssi_history)
            if len(self._rssi_history) >= 2:
                prev_avg = sum(self._rssi_history[:-1]) / len(self._rssi_history[:-1])
                if avg > prev_avg + 1:
                    arrow = "▲"
                elif avg < prev_avg - 1:
                    arrow = "▼"
                else:
                    arrow = "─"
            else:
                arrow = "─"
            return avg, arrow

        def _update_stats(self):
            """Update the stats bar with zone, trend, interval, count."""
            try:
                stats_widget = self.query_one("#log-stats")
            except Exception:
                return

            rssi = self._prev_rssi
            zone = self._compute_zone(rssi)

            # RSSI trend
            avg, arrow = self._compute_rssi_trend()
            trend_str = f"avg={avg:.0f}dBm {arrow}" if avg is not None else "—"

            # Advertisement interval
            interval_str = "—"
            if self._last_event_time is not None and self._first_event_time is not None:
                dt = (self._last_event_time - self._first_event_time).total_seconds()
                if dt > 0 and self._event_count > 1:
                    interval_str = f"{dt / (self._event_count - 1):.1f}s avg"

            # Events per minute
            now = datetime.now()
            cutoff = now - timedelta(minutes=1)
            recent = [t for t in self._event_times if t > cutoff]
            epm = len(recent)

            zone_colors = {
                "immediate": "bold green",
                "near": "green",
                "far": "yellow",
                "remote": "red",
                "unknown": "dim",
            }
            zone_style = zone_colors.get(zone, "dim")

            stats = (
                f"Zone: [{zone_style}]{zone}[/]  │  "
                f"Trend: {trend_str}  │  "
                f"Interval: {interval_str}  │  "
                f"Events: {self._event_count} total, {epm}/min"
            )
            stats_widget.update(stats)

        def _build_rssi_graph(self):
            """Build an ASCII bar chart of RSSI history."""
            history = self._graph_data
            if not history:
                return "Awaiting signal data..."

            rssi_min = -100
            rssi_max = -30
            rssi_range = rssi_max - rssi_min  # 70
            graph_height = 8
            max_cols = 80

            readings = [rssi for _, rssi in history[-max_cols:]]
            n = len(readings)
            padding = max_cols - n

            current_rssi = readings[-1]
            zone = self._compute_zone(current_rssi)

            zone_styles = {
                "immediate": "bold green",
                "near": "green",
                "far": "yellow",
                "remote": "red",
                "unknown": "dim",
            }
            zone_style = zone_styles.get(zone, "dim")

            header = f"Signal  \u25b2  {current_rssi} dBm  [{zone_style}]{zone}[/]"

            lines = []
            for row in range(graph_height):
                threshold = rssi_min + rssi_range * (graph_height - row) / graph_height

                line_parts = [" "] * padding
                for rssi in readings:
                    if rssi is not None and rssi >= threshold:
                        if rssi > -50:
                            line_parts.append("[green]\u2588[/green]")
                        elif rssi > -70:
                            line_parts.append("[yellow]\u2588[/yellow]")
                        else:
                            line_parts.append("[red]\u2588[/red]")
                    else:
                        line_parts.append(" ")
                lines.append("".join(line_parts))

            lines.append("\u2500" * max_cols)
            lines.append("[green]\u2588[/] >-50  [yellow]\u2588[/] -50~-70  [red]\u2588[/] <-70")

            return "\n".join([header] + lines)

        def _update_graph(self):
            """Update the RSSI graph widget."""
            try:
                widget = self.query_one("#rssi-graph")
                widget.update(self._build_rssi_graph())
            except Exception:
                pass

        async def on_mount(self) -> None:
            self._start_scanning()

        def _start_scanning(self):
            import asyncio

            async def _scan():
                from bleak import BleakScanner
                target = self.target_id

                def callback(device, adv):
                    if str(device.address) != target:
                        return
                    now = datetime.now()
                    now_str = now.strftime("%H:%M:%S.%f")[:-3]
                    rssi = adv.rssi
                    md = adv.manufacturer_data
                    services = [str(s) for s in (adv.service_uuids or [])]
                    name = adv.local_name or device.name or ""

                    # Track seen count and timing
                    self._event_count += 1
                    if self._first_event_time is None:
                        self._first_event_time = now
                    self._last_event_time = now
                    self._event_times.append(now)

                    # Track RSSI for trend
                    if rssi is not None:
                        self._rssi_history.append(rssi)
                        if len(self._rssi_history) > 5:
                            self._rssi_history = self._rssi_history[-5:]

                    # Track RSSI for graph
                    if rssi is not None:
                        self._graph_data.append((now, rssi))
                        if len(self._graph_data) > 120:
                            self._graph_data = self._graph_data[-120:]

                    # Decode Apple Continuity
                    apple_info = ""
                    apple_payload = md.get(0x004C)
                    if apple_payload:
                        tlvs = parse_apple_tlvs(bytes(apple_payload))
                        parts = []
                        for t, payload in tlvs:
                            tname = APPLE_TYPES.get(t, f"0x{t:02X}")
                            detail = ""
                            if t == 0x02 and len(payload) >= 21:
                                maj = int.from_bytes(payload[16:18], "big")
                                mnr = int.from_bytes(payload[18:20], "big")
                                detail = f" maj={maj} min={mnr}"
                            elif t == 0x10 and len(payload) >= 1:
                                code = payload[0] & 0x0F
                                detail = f" action={NEARBY_ACTION.get(code, code)}"
                            elif t in (0x07, 0x0F) and len(payload) >= 3:
                                b = payload[:8]
                                lo = [x & 0x0F for x in b]
                                bats = []
                                if lo[0]: bats.append(f"L={lo[0]*100//14}%")
                                if len(lo) > 1 and lo[1]: bats.append(f"R={lo[1]*100//14}%")
                                if len(lo) > 2 and lo[2]: bats.append(f"C={lo[2]*100//14}%")
                                if bats: detail = " " + ",".join(bats)
                            parts.append(f"{tname}{detail}")
                        apple_info = " | Apple: " + ", ".join(parts)

                    # Continuity Spam Detection
                    spam_tag = ""
                    if apple_payload:
                        spam_matches = detect_continuity_spam(bytes(apple_payload))
                        if spam_matches:
                            self._spam_count += 1
                            tags = []
                            for sname, sev in spam_matches:
                                if sev == "critical":
                                    tags.append(f"[bold red][CRITICAL] {sname}[/]")
                                elif sev == "warning":
                                    tags.append(f"[bold yellow][SPAM] {sname}[/]")
                                else:
                                    tags.append(f"[yellow][SPAM] {sname}[/]")
                            spam_tag = "  " + " ".join(tags)

                    # RSSI delta
                    rssi_delta = ""
                    if self._prev_rssi is not None:
                        delta = rssi - self._prev_rssi
                        if delta != 0:
                            rssi_delta = f" ({delta:+d})"
                    self._prev_rssi = rssi

                    # Proximity zone
                    zone = self._compute_zone(rssi)
                    zone_label = f" [{zone}]" if rssi is not None else ""

                    svc_str = f" Svc:[{','.join(services)}]" if services else ""
                    name_str = f' Name:"{name}"' if name else ""

                    entry = f"[dim]{now_str}[/]  {rssi}dBm{rssi_delta}{zone_label}{apple_info}{spam_tag}{svc_str}{name_str}"
                    self.log_entries.append(entry)
                    self._update_display()
                    self._update_stats()
                    self._update_graph()

                try:
                    self._scanner = BleakScanner(callback)
                    await self._scanner.start()
                    await asyncio.sleep(300)  # 5 minutes max
                    await self._scanner.stop()
                except Exception as e:
                    self.log_entries.append(f"[red]Scanner error: {e}[/red]")
                    self._update_display()

            self.run_worker(_scan, exclusive=True, group="actionlog")

        def _update_display(self):
            try:
                widget = self.query_one("#log-entries")
                # Show last 100 entries
                visible = self.log_entries[-100:]
                widget.update("\n".join(visible))
                # Auto-scroll to bottom
                widget.scroll_end()
            except Exception:
                pass

        def action_close(self) -> None:
            if self._scanner:
                import asyncio
                try:
                    asyncio.get_event_loop().create_task(self._scanner.stop())
                except Exception:
                    pass
            self.dismiss()


    class DeviceGATTScreen(ModalScreen):
        """GATT service/characteristic browser for a BLE device."""

        CSS = """

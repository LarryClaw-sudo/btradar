CACHE_DIR = os.path.expanduser("~/.cache/btwho")
OUI_FILE = os.path.join(CACHE_DIR, "oui.txt")
OUI_URL = "https://standards-oui.ieee.org/oui/oui.txt"
MAC_LOOKUP_API = "https://api.maclookup.app/v2/macs/"

_oui_db = None


def load_oui(refresh=False):
    """Parse the IEEE MA-L registry into {PREFIX: vendor}."""
    global _oui_db
    if _oui_db is not None:
        return _oui_db
    if refresh and os.path.exists(OUI_FILE):
        os.remove(OUI_FILE)
    if not os.path.exists(OUI_FILE):
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            print("  \u2b07  Downloading IEEE OUI registry (~6 MB, once)...",
                  file=sys.stderr)
            urllib.request.urlretrieve(OUI_URL, OUI_FILE)
        except Exception as e:
            print(f"  \u26a0  OUI download failed ({e}); using online fallback only",
                  file=sys.stderr)
            _oui_db = {}
            return _oui_db
    _oui_db = {}
    rx = re.compile(
        r"^([0-9A-F]{2})-([0-9A-F]{2})-([0-9A-F]{2})\s+\(hex\)\s+(.+?)\s*$"
    )
    with open(OUI_FILE, "r", errors="ignore") as fh:
        for line in fh:
            m = rx.match(line)
            if m:
                _oui_db[m.group(1) + m.group(2) + m.group(3)] = m.group(4)
    return _oui_db


def norm_addr(addr):
    """Normalize MAC: AA-BB-CC-DD-EE-FF / AA:BB:.. / AABBCC.. -> AABBCCDDEEFF"""
    return re.sub(r"[^0-9A-Fa-f]", "", addr).upper()


def is_real_mac(addr):
    """True if the address is a real 48-bit MAC."""
    return len(norm_addr(addr)) == 12


def is_randomized(addr):
    """Locally-administered bit set => randomized / private address."""
    hexs = norm_addr(addr)
    if len(hexs) != 12:
        return False
    return bool(int(hexs[0:2], 16) & 0x02)


def vendor_lookup(addr, online=True):
    """Resolve MAC prefix to vendor name."""
    hexs = norm_addr(addr)
    if len(hexs) < 6:
        return None
    prefix = hexs[:6]
    v = load_oui().get(prefix)
    if v:
        return v
    if not online:
        return None
    try:
        with urllib.request.urlopen(MAC_LOOKUP_API + hexs[:12], timeout=6) as r:
            j = json.loads(r.read().decode())
        if j.get("found"):
            return j.get("company")
    except Exception:
        pass
    return None



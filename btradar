        }
        """

        BINDINGS = [
            Binding("escape", "close", "Close"),
            Binding("r", "read_char", "Read"),
            Binding("a", "run_audit", "Audit"),
        ]

        def __init__(self, device_uuid, tracker=None):
            super().__init__()
            self.device_uuid = device_uuid
            self.tracker = tracker
            self._client = None
            self._services_data = []
            self._char_rows = {}  # row_key -> (service_uuid, char_uuid)
            self._audit_findings = []
            self._security_score = None

        def compose(self) -> ComposeResult:
            from textual.containers import Vertical
            with Vertical(id="gatt-container"):
                yield Static(f"GATT: {self.device_uuid}", id="gatt-title")
                yield Static("Connecting...", id="gatt-status")
                yield Static("", id="gatt-audit-panel")
                yield DataTable(id="gatt-table", cursor_type="row")
                yield Label("[dim]r: read value | a: security audit | Esc: disconnect & close[/dim]", id="gatt-hint")

        async def on_mount(self) -> None:
            table = self.query_one("#gatt-table")
            table.add_column("SERVICE / CHARACTERISTIC")
            table.add_column("PROPERTIES")
            table.add_column("VALUE")
            table.add_column("UUID")
            self.run_worker(self._connect_and_discover, exclusive=True, group="gatt")

        async def _connect_and_discover(self):
            from bleak import BleakClient

            try:
                status = self.query_one("#gatt-status")
                status.update("Connecting...")
            except Exception:
                pass

            try:
                self._client = BleakClient(self.device_uuid)
                await self._client.connect(timeout=15.0)
            except Exception as e:
                try:
                    self.query_one("#gatt-status").update(f"[red]Connect failed: {e}[/red]")
                except Exception:
                    pass
                return

            try:
                self.query_one("#gatt-status").update("Connected — discovering services...")
            except Exception:
                pass

            try:
                table = self.query_one("#gatt-table")
                self._services_data = []
                self._char_rows = {}
                row_idx = 0

                for service in self._client.services:
                    svc_uuid = str(service.uuid)
                    svc_name = service.name or ""
                    svc_label = f"SERVICE: {svc_uuid}" + (f" ({svc_name})" if svc_name else "")
                    row_key = f"svc_{row_idx}"
                    table.add_row(
                        Text(svc_label, style="bold cyan"),
                        Text(""),
                        Text(""),
                        Text(svc_uuid, style="dim"),
                        key=row_key,
                    )
                    self._services_data.append({"uuid": svc_uuid, "name": svc_name, "chars": []})
                    row_idx += 1

                    for char in service.characteristics:
                        char_uuid = str(char.uuid)
                        char_name = char.name or ""
                        props = ", ".join(char.properties)
                        char_label = f"  └ {char_uuid}" + (f" ({char_name})" if char_name else "")
                        row_key = f"char_{row_idx}"
                        table.add_row(
                            Text(char_label, style="green"),
                            Text(props, style="yellow"),
                            Text("(not read)", style="dim"),
                            Text(char_uuid, style="dim"),
                            key=row_key,
                        )
                        self._char_rows[row_key] = (svc_uuid, char_uuid)
                        self._services_data[-1]["chars"].append({
                            "uuid": char_uuid,
                            "name": char_name,
                            "properties": char.properties,
                            "value": None,
                        })
                        row_idx += 1

                try:
                    self.query_one("#gatt-status").update(
                        f"Connected — {len(self._services_data)} services, "
                        f"{sum(len(s['chars']) for s in self._services_data)} characteristics"
                    )
                except Exception:
                    pass

                # Run security audit automatically
                self._run_audit_on_data()

            except Exception as e:
                try:
                    self.query_one("#gatt-status").update(f"[red]Discovery error: {e}[/red]")
                except Exception:
                    pass

        def action_run_audit(self):
            """Run security audit on-demand (binding 'a')."""
            if not self._services_data:
                try:
                    self.query_one("#gatt-status").update("[yellow]No services discovered yet[/yellow]")
                except Exception:
                    pass
                return
            self._run_audit_on_data()

        def _run_audit_on_data(self):
            """Run the security audit on current services data and display results."""
            self._audit_findings, self._security_score = audit_gatt_security(self._services_data)
            self._display_audit_panel()

        def _display_audit_panel(self):
            """Update the audit panel widget with findings and score."""
            try:
                panel = self.query_one("#gatt-audit-panel")
            except Exception:
                return

            if not self._audit_findings:
                panel.update("[dim]Security Audit: No issues found (Score: A)[/dim]")
                return

            score = self._security_score or "A"
            score_colors = {"A": "green", "B": "blue", "C": "yellow", "D": "red", "F": "bold red"}
            score_color = score_colors.get(score, "dim")

            lines = [f"[bold]Security Audit — Grade: [{score_color}]{score}[/][/bold]"]

            for severity, text in self._audit_findings:
                if severity == "critical":
                    lines.append(f"  [bold red][CRITICAL][/bold red] {text}")
                elif severity == "warning":
                    lines.append(f"  [yellow][WARNING][/yellow] {text}")
                else:
                    lines.append(f"  [blue][INFO][/blue] {text}")

            panel.update("\n".join(lines))

        def action_read_char(self):
            """Read the value of the selected characteristic."""
            table = self.query_one("#gatt-table")
            if table.cursor_row is None:
                return
            row_key = str(table.cursor_row_key)
            if row_key not in self._char_rows:
                return  # Not a characteristic row
            self.run_worker(
                self._read_characteristic, row_key, exclusive=True, group="gatt-read"
            )

        async def _read_characteristic(self, row_key):
            if not self._client or not self._client.is_connected:
                return

            svc_uuid, char_uuid = self._char_rows[row_key]
            try:
                status = self.query_one("#gatt-status")
                status.update(f"Reading {char_uuid}...")
            except Exception:
                pass

            try:
                value = await self._client.read_gatt_char(char_uuid)
                # Format value as hex + ASCII
                hex_str = value.hex()
                ascii_str = ""
                try:
                    ascii_str = value.decode("utf-8", errors="replace")
                    ascii_str = "".join(c if 32 <= ord(c) < 127 else "." for c in ascii_str)
                except Exception:
                    pass
                display_val = hex_str[:60]
                if ascii_str:
                    display_val += f"  ({ascii_str[:30]})"

                # Update table
                table = self.query_one("#gatt-table")
                rows = list(table.rows.keys())
                if row_key in rows:
                    cells = table.get_row(row_key)
                    # cells is a tuple; replace the value column (index 2)
                    new_cells = list(cells)
                    new_cells[2] = Text(display_val, style="bold white")
                    table.remove_row(row_key)
                    # Re-insert at the same position
                    idx = rows.index(row_key)
                    # We need to rebuild the table to maintain order
                    # Instead, just update the data and rebuild
                    pass

                # Simpler approach: update via remove and re-add
                # Actually, let's just update the cell display differently
                # DataTable doesn't have a cell-update API, so let's use a different approach

                # Store value on the services data
                for svc in self._services_data:
                    for ch in svc["chars"]:
                        if ch["uuid"] == char_uuid:
                            ch["value"] = value.hex()

                # Rebuild the table to show the value
                self._rebuild_table()

                try:
                    self.query_one("#gatt-status").update(
                        f"Read {char_uuid}: {hex_str[:40]}"
                    )
                except Exception:
                    pass

            except Exception as e:
                try:
                    self.query_one("#gatt-status").update(f"[red]Read error: {e}[/red]")
                except Exception:
                    pass

        def _rebuild_table(self):
            """Rebuild the table with current data including read values."""
            table = self.query_one("#gatt-table")
            table.clear()
            self._char_rows = {}
            row_idx = 0

            for svc in self._services_data:
                svc_label = f"SERVICE: {svc['uuid']}" + (f" ({svc['name']})" if svc['name'] else "")
                row_key = f"svc_{row_idx}"
                table.add_row(
                    Text(svc_label, style="bold cyan"),
                    Text(""),
                    Text(""),
                    Text(svc["uuid"], style="dim"),
                    key=row_key,
                )
                row_idx += 1

                for ch in svc["chars"]:
                    char_label = f"  └ {ch['uuid']}" + (f" ({ch['name']})" if ch['name'] else "")
                    props = ", ".join(ch["properties"])
                    if ch["value"]:
                        hex_str = ch["value"]
                        val_display = hex_str[:60]
                    else:
                        val_display = "(not read)"
                    row_key = f"char_{row_idx}"
                    table.add_row(
                        Text(char_label, style="green"),
                        Text(props, style="yellow"),
                        Text(val_display, style="bold white" if ch["value"] else "dim"),
                        Text(ch["uuid"], style="dim"),
                        key=row_key,
                    )
                    self._char_rows[row_key] = (svc["uuid"], ch["uuid"])
                    row_idx += 1

        def action_close(self) -> None:
            self.run_worker(self._disconnect, exclusive=True, group="gatt-close")

        async def _disconnect(self):
            if self._client and self._client.is_connected:
                try:
                    # Store GATT data on tracker device if available
                    if self.tracker:
                        dev = self.tracker.get_by_id(self.device_uuid)
                        if dev:
                            dev["gatt_services"] = self._services_data
                            if self._security_score:
                                dev["gatt_security_score"] = self._security_score
                    await self._client.disconnect()
                except Exception:
                    pass
            self.dismiss()



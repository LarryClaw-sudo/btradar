        # ── Table ──────────────────────────────────────────────────

        def _build_row_cells(self, dev):
            """Build styled cells for one device row."""
            dtype = dev["type"]
            if dtype == "Apple":
                base = "cyan"
            elif dtype == "Classic":
                base = "green"
            else:
                base = "blue"

            name = dev["name"] or dev.get("apple_identity") or "(unknown)"
            name_cell = Text(name[:36], style=base)

            if is_real_mac(dev["address"]):
                if dev.get("vendor"):
                    vendor_str = dev["vendor"][:28]
                elif dev.get("random"):
                    vendor_str = "private/randomized"
                else:
                    vendor_str = "unknown"
            else:
                vendor_str = "n/a (macOS hides MAC)"
            vendor_cell = Text(vendor_str, style=base)

            addr = dev["address"]
            if dev.get("random"):
                addr += " \U0001f504"
            addr_cell = Text(addr, style=f"dim {base}")

            type_cell = Text(dtype, style=f"bold {base}")

            rssi = dev.get("rssi")
            if rssi is not None:
                bar = signal_bar(rssi)
                signal_cell = Text(f"{rssi:>5}dBm {bar}", style=rssi_color(rssi))
            else:
                signal_cell = Text("    \u2014  \u2591" * 5, style="dim")

            identity = dev.get("apple_identity") or ""
            if not identity and dev.get("paired"):
                identity = "paired"
            elif not identity and dev.get("connected"):
                identity = "connected"
            identity_cell = Text(identity, style=base if identity else "dim")

            return [name_cell, vendor_cell, addr_cell, type_cell, signal_cell, identity_cell]

        def _refresh_table(self) -> None:
            table = self.query_one(DataTable)
            table.clear()

            devices = self._tracker.get_sorted()

            # Apply filter
            if self._filter_text:
                ft = self._filter_text.lower()
                devices = [
                    d for d in devices
                    if ft in (d["name"] or "").lower()
                    or ft in (d.get("vendor") or "").lower()
                    or ft in (d["address"] or "").lower()
                    or ft in (d.get("apple_identity") or "").lower()
                ]

            if not devices:
                placeholder = (
                    f"No matches for '{self._filter_text}'"
                    if self._filter_text
                    else "No devices found. Press 's' to scan."
                )
                table.add_row(
                    Text(placeholder, style="dim"),
                    Text(""), Text(""), Text(""), Text(""), Text(""),
                    key="__empty__",
                )
            else:
                for dev in devices:
                    cells = self._build_row_cells(dev)
                    table.add_row(*cells, key=dev["id"])

            self._update_status_bar()

        # ── Filter ─────────────────────────────────────────────────

        def on_input_changed(self, event: Input.Changed) -> None:
            if event.input.id == "filter-input":
                self._filter_text = event.value
                self._refresh_table()

        # ── Row selection → inspect ────────────────────────────────

        def on_data_table_row_selected(self, event: DataTable.RowSelected) -> None:
            row_key = str(event.row_key)
            if row_key == "__empty__":
                return
            device = self._tracker.get_by_id(row_key)
            if device:
                self.push_screen(DeviceInspectScreen(device))

        # ── Escape from filter ─────────────────────────────────────

        def on_key(self, event: events.Key) -> None:
            if event.key == "escape":
                filter_input = self.query_one("#filter-input")
                if filter_input.display:
                    event.stop()
                    self.action_toggle_filter()

        # ── Status bar ─────────────────────────────────────────────

        def _status_text(self, message=""):
            count = len(self._tracker.devices)
            ts = datetime.now().strftime("%H:%M:%S")
            filter_info = f" | Filter: {self._filter_text}" if self._filter_text else ""

            if message:
                parts = [
                    f"btradar v{__version__}",
                    message,
                    f"{count} device(s){filter_info}",
                    ts,
                ]
            else:
                parts = [
                    f"btradar v{__version__}",
                    "s:scan  Enter:inspect  /:filter  q:quit",
                    f"{count} device(s){filter_info}",
                    ts,
                ]
            return " | ".join(parts)

        def _update_status_bar(self, message=""):
            try:
                self.query_one("#status-bar").update(self._status_text(message))
            except Exception:
                pass


    # ╔══════════════════════════════════════════════════════════════════╗
    # ║  ONE-SHOT / JSON / LOOKUP OUTPUT                               ║
    # ╚══════════════════════════════════════════════════════════════════╝

    # ║  CLI ENTRY POINT                                                ║
    # ╚══════════════════════════════════════════════════════════════════╝


    return BTRadarApp


def _build_rich_row(dev):
    """Build a Rich-table row dict for one device (used by one-shot output)."""
    from rich.text import Text

    name = dev["name"] or dev.get("apple_identity") or "(unknown)"
    name = name[:36]

    if is_real_mac(dev["address"]):
        if dev.get("vendor"):
            vendor_str = dev["vendor"][:28]
        elif dev.get("random"):
            vendor_str = "private/randomized"
        else:
            vendor_str = "unknown"
    else:
        vendor_str = "n/a (macOS hides MAC)"

    addr = dev["address"]
    if dev.get("random"):
        addr += " \U0001f504"

    dtype = dev["type"]
    if dtype == "Apple":
        type_style = "bold cyan"
    elif dtype == "Classic":
        type_style = "green"
    else:
        type_style = "blue"

    rssi_val = dev.get("rssi")
    if rssi_val is not None:
        bar = signal_bar(rssi_val)
        rssi_str = f"{rssi_val:>5}dBm"
        signal = Text(f"{rssi_str} {bar}", style=rssi_color(rssi_val))
    else:
        signal = Text("    \u2014  \u2591" * 5, style="dim")

    identity = dev.get("apple_identity") or ""
    if not identity and dev.get("paired"):
        identity = "paired"
    elif not identity and dev.get("connected"):
        identity = "connected"

    return {
        "NAME": Text(name, style=type_style),
        "VENDOR": Text(vendor_str, style=type_style),
        "ADDRESS": Text(addr, style=f"dim {type_style}"),
        "TYPE": Text(dtype, style=f"bold {type_style}"),
        "SIGNAL": signal,
        "IDENTITY": Text(identity, style=type_style if identity else "dim"),
    }


def one_shot_table(classic_sec, ble_sec, classic_only, ble_only):
    """Single scan, pretty table to stdout."""
    from rich.console import Console
    from rich.table import Table

    console = Console()
    devices = do_scan(classic_sec, ble_sec, classic_only, ble_only)
    devices.sort(
        key=lambda d: d["rssi"] if d["rssi"] is not None else -999, reverse=True
    )

    ts = datetime.now().strftime("%Y-%m-%d %H:%M")
    table = Table(
        title=f"[bold]\U0001f4e1  btradar[/]  [dim]{ts}  \u2022  {len(devices)} device(s)[/]",
        show_lines=False,
        pad_edge=True,
        padding=(0, 1),
        border_style="dim",
    )
    table.add_column("NAME", style="bold", no_wrap=True, min_width=28, max_width=38)
    table.add_column("VENDOR", no_wrap=True, min_width=16, max_width=30)
    table.add_column("ADDRESS", style="dim", no_wrap=True, min_width=18)
    table.add_column("TYPE", no_wrap=True, min_width=10)
    table.add_column("SIGNAL", no_wrap=True, min_width=22)
    table.add_column("IDENTITY", style="cyan", no_wrap=True, min_width=12)

    if not devices:
        console.print(
            "[dim]No devices found. Bluetooth may be off, "
            "or nothing is advertising.[/dim]"
        )
        return

    for dev in devices:
        row = _build_rich_row(dev)
        table.add_row(
            row["NAME"], row["VENDOR"], row["ADDRESS"],
            row["TYPE"], row["SIGNAL"], row["IDENTITY"],
        )

    console.print(table)
    console.print(
        "[dim]  'random' \U0001f504 = address rotates, identity can't be tracked[/]"
    )


def json_output(classic_sec, ble_sec, classic_only, ble_only):
    """Single scan, JSON output."""
    devices = do_scan(classic_sec, ble_sec, classic_only, ble_only)
    devices.sort(
        key=lambda d: d["rssi"] if d["rssi"] is not None else -999, reverse=True
    )

    stamp = datetime.now().strftime("%Y-%m-%d %H:%M")
    for d in devices:
        if d.get("apple_details"):
            d["apple_details"] = [
                {"type": t, "detail": detail} for t, detail in d["apple_details"]
            ]
    print(
        json.dumps(
            {"scanned": stamp, "version": __version__, "devices": devices},
            indent=2,
        )
    )


def lookup_one(addr, online=True):
    """Resolve a single MAC address."""
    from rich.console import Console

    console = Console()
    v = vendor_lookup(addr, online=online)
    rnd = is_randomized(addr)
    mac = is_real_mac(addr)

    parts = []
    parts.append(f"[bold]{addr}[/]")
    if v:
        parts.append(f"  Vendor: [green]{v}[/]")
    else:
        parts.append("  Vendor: [dim]no match[/]")
    if rnd:
        parts.append("  [yellow]\u26a0 Randomized / private MAC (locally administered)[/]")
    if not mac:
        parts.append(
            "  [dim]Not a real 48-bit MAC (BLE UUID on macOS?)[/]"
        )
    console.print("".join(parts))



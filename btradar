def _bootstrap_venv():
    """Create venv, install deps, re-exec with venv python."""
    if sys.prefix != sys.base_prefix:
        return  # Already inside a venv

    need_deps = False
    for pkg in ("bleak", "rich", "textual"):
        try:
            __import__(pkg)
        except ImportError:
            need_deps = True
            break

    if not need_deps:
        return

    if not os.path.isfile(VENV_PY):
        print("\U0001f4e6  Setting up btradar environment (first run)...")
        subprocess.check_call([sys.executable, "-m", "venv", VENV_DIR])
        subprocess.check_call(
            [VENV_PY, "-m", "pip", "install", "--quiet", "bleak", "rich", "textual"]
        )
        print("\u2705  Environment ready. Starting btradar...\n")

    os.execv(VENV_PY, [VENV_PY, SCRIPT_PATH] + sys.argv[1:])


_bootstrap_venv()


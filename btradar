# ║  BLE + APPLE SCANNER (bleak)                                   ║
# ╚══════════════════════════════════════════════════════════════════╝

def scan_ble(seconds):
    """Bleak BLE scanner: all BLE devices, with Apple Continuity decode."""
    import asyncio
    from bleak import BleakScanner

    found = []

    def callback(device, advertisement_data):
        md = advertisement_data.manufacturer_data
        rssi = advertisement_data.rssi
        name = device.name or ""
        addr = device.address
        is_apple = APPLE_COMPANY_ID in md

        apple_id = None
        apple_det = []
        if is_apple:
            apple_id, apple_det = decode_apple_identity(md)

        found.append({
            "id": addr,
            "name": name,
            "address": addr,
            "type": "Apple" if is_apple else "BLE",
            "rssi": rssi,
            "vendor": None,
            "random": False,
            "paired": False,
            "connected": False,
            "apple_identity": apple_id,
            "apple_details": apple_det,
        })

    async def _run():
        try:
            scanner = BleakScanner(callback)
        except Exception:
            scanner = BleakScanner(callback, cb={})
        await scanner.start()
        await asyncio.sleep(seconds)
        await scanner.stop()

    asyncio.run(_run())
    return found



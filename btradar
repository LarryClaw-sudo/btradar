# ║  DEVICE TRACKER                                                ║
# ╚══════════════════════════════════════════════════════════════════╝

class DeviceTracker:
    """Tracks all seen devices across scan cycles within a session."""

    def __init__(self):
        self.devices = {}  # keyed by stable_id

    def update(self, scan_results):
        """Update tracker with new scan results."""
        now = datetime.now()
        for dev in scan_results:
            sid = dev["id"]
            if sid in self.devices:
                existing = self.devices[sid]
                existing["rssi"] = dev["rssi"]
                existing["last_seen"] = now
                if dev["name"]:
                    existing["name"] = dev["name"]
                if dev.get("vendor"):
                    existing["vendor"] = dev["vendor"]
                if dev.get("apple_identity"):
                    existing["apple_identity"] = dev["apple_identity"]
                if dev.get("apple_details"):
                    existing["apple_details"] = dev["apple_details"]
            else:
                entry = dict(dev)
                entry["first_seen"] = now
                entry["last_seen"] = now
                self.devices[sid] = entry

    def get_sorted(self):
        """Return devices sorted by RSSI (strongest first)."""
        return sorted(
            self.devices.values(),
            key=lambda d: d["rssi"] if d["rssi"] is not None else -999,
            reverse=True,
        )

    def get_by_id(self, stable_id):
        return self.devices.get(stable_id)



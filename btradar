# ║  UNIFIED SCANNER                                                ║
# ╚══════════════════════════════════════════════════════════════════╝

def do_scan(classic_sec, ble_sec, classic_only=False, ble_only=False):
    """Run both scanners (or one), merge results, deduplicate."""
    devices = {}

    if not ble_only:
        classic = scan_classic(classic_sec)
        if classic is None:
            print("  \u2139  blueutil not found \u2014 skipping Classic BT "
                  "(brew install blueutil)", file=sys.stderr)
        else:
            for d in classic:
                devices[d["id"]] = d

    if not classic_only:
        try:
            ble = scan_ble(ble_sec)
        except ImportError:
            print("  \u2139  bleak not found \u2014 skipping BLE "
                  "(should have been auto-installed)", file=sys.stderr)
            ble = []
        for d in ble:
            if d["id"] not in devices:
                devices[d["id"]] = d

    return list(devices.values())



def check_bluetooth_available():
    """Check if Bluetooth hardware/permission is available on macOS.
    Returns (available: bool, message: str).
    """
    if sys.platform != "darwin":
        return True, ""  # Not macOS, skip check

    if _have("blueutil"):
        out = _run_cmd(["blueutil", "-p"], 5)
        if out is not None:
            val = out.strip()
            if val == "0":
                return False, "Bluetooth is OFF. Turn it on: blueutil -p 1"
            return True, ""

    try:
        import asyncio
        from bleak import BleakScanner

        async def _quick_check():
            try:
                scanner = BleakScanner()
                await scanner.start()
                await asyncio.sleep(0.5)
                await scanner.stop()
                return True, ""
            except Exception as e:
                err = str(e)
                if "permission" in err.lower() or "CBATTErrorDomain" in err.lower():
                    return False, (
                        "Bluetooth permission denied. "
                        "Grant access: System Settings > Privacy > Bluetooth > Terminal"
                    )
                if "power" in err.lower() or "off" in err.lower():
                    return False, "Bluetooth may be OFF or unavailable."
                return True, ""

        return asyncio.run(_quick_check())
    except ImportError:
        pass

    return True, ""



            table = self.query_one(DataTable)
            if table.cursor_row is None:
                return
            # Build the same sorted/filtered list that populates the table
            devices = self._tracker.get_sorted()
            if self._filter_text:
                ft = self._filter_text.lower()
                devices = [
                    d for d in devices
                    if ft in (d.get("name") or "").lower()
                    or ft in (d.get("vendor") or "").lower()
                    or ft in (d.get("address") or "").lower()
                    or ft in (d.get("apple_identity") or "").lower()
                ]

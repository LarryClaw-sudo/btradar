            self.device = device

        def compose(self) -> ComposeResult:
            d = self.device
            from textual.containers import Vertical

            content = self._build_content(d)

            with Vertical(id="inspect-container"):
                yield Static("Device Detail", id="inspect-title")
                yield Static(content, id="inspect-content")
                yield Label("[dim]Press Esc to close[/dim]", id="inspect-hint")

        def _build_content(self, d):
            lines = []

            name = d["name"] or d.get("apple_identity") or "(unknown)"
            lines.append(f"  Name:         {name}")
            lines.append(f"  Vendor:       {d.get('vendor') or 'unknown'}")
            lines.append(f"  Address:      {d['address']}")

            rnd = d.get("random", False)
            type_str = d["type"]
            if rnd:
                type_str += "  \U0001f504 randomized"
            lines.append(f"  Type:         {type_str}")

            rssi = d.get("rssi")
            if rssi is not None:
                bar = signal_bar(rssi, width=20)
                color_label = "strong" if rssi >= -50 else ("medium" if rssi >= -70 else "weak")
                lines.append(f"  Signal:       {rssi} dBm  {bar}  ({color_label})")
            else:
                empty_bar = '░' * 20
                lines.append(f"  Signal:       —  {empty_bar}")

            lines.append(f"  Randomized:   {'yes' if rnd else 'no'}")

            if d.get("first_seen"):
                lines.append(f"  First seen:   {d['first_seen'].strftime('%H:%M:%S')}")
            if d.get("last_seen"):
                lines.append(f"  Last seen:    {d['last_seen'].strftime('%H:%M:%S')}")

            if d.get("paired"):
                lines.append(f"  Paired:       yes")
            if d.get("connected"):
                lines.append(f"  Connected:    yes")

            if d.get("apple_identity"):
                lines.append(f"")
                lines.append(f"  Apple Identity: {d['apple_identity']}")

            if d.get("apple_details"):
                lines.append(f"  Continuity Details:")
                for t, detail in d["apple_details"]:
                    lines.append(f"    \u2022 {t}{': ' + detail if detail else ''}")

            return "\n".join(lines)

        def action_close(self) -> None:
            self.dismiss()


    class DeviceActionLogScreen(ModalScreen):
        """Live action log for a single BLE device."""

        CSS = """
        DeviceActionLogScreen {
            align: center middle;
        }
        #log-container {
            width: 90;
            height: 85%;
            border: thick $primary;
            background: $surface;
            padding: 1 2;
        }
        #log-title {
            text-style: bold;
            text-align: center;
            margin-bottom: 1;
            color: $accent;
        }
        #log-entries {
            height: 1fr;
            overflow-y: auto;
        }
        #log-hint {
            text-align: center;
            margin-top: 1;
            color: $text-muted;
        }
        """

        BINDINGS = [
            Binding("escape", "close", "Close"),
        ]

        def __init__(self, device):
            super().__init__()
            self.device = device
            self.target_id = device["id"]
            self.log_entries = []
            self._scanner = None
            self._prev_rssi = None

        def compose(self) -> ComposeResult:
            from textual.containers import Vertical
            name = self.device.get("name") or self.device.get("apple_identity") or self.target_id[:12]
            with Vertical(id="log-container"):
                yield Static(f"Action Log: {name}", id="log-title")
                yield Static("Waiting for advertisements...", id="log-entries")
                yield Label("[dim]Esc to close | Watching for BLE events from this device[/dim]", id="log-hint")

        async def on_mount(self) -> None:
            self._start_scanning()

        def _start_scanning(self):
            import asyncio

            async def _scan():
                from bleak import BleakScanner
                target = self.target_id

                def callback(device, adv):
                    if str(device.address) != target:
                        return
                    now = datetime.now().strftime("%H:%M:%S.%f")[:-3]
                    rssi = adv.rssi
                    md = adv.manufacturer_data
                    services = [str(s) for s in (adv.service_uuids or [])]
                    name = adv.local_name or device.name or ""

                    # Decode Apple Continuity
                    apple_info = ""
                    apple_payload = md.get(0x004C)
                    if apple_payload:
                        tlvs = parse_apple_tlvs(bytes(apple_payload))
                        parts = []
                        for t, payload in tlvs:
                            tname = APPLE_TYPES.get(t, f"0x{t:02X}")
                            detail = ""
                            if t == 0x02 and len(payload) >= 21:
                                maj = int.from_bytes(payload[16:18], "big")
                                mnr = int.from_bytes(payload[18:20], "big")
                                detail = f" maj={maj} min={mnr}"
                            elif t == 0x10 and len(payload) >= 1:
                                code = payload[0] & 0x0F
                                detail = f" action={NEARBY_ACTION.get(code, code)}"
                            elif t in (0x07, 0x0F) and len(payload) >= 3:
                                b = payload[:8]
                                lo = [x & 0x0F for x in b]
                                bats = []
                                if lo[0]: bats.append(f"L={lo[0]*100//14}%")
                                if len(lo) > 1 and lo[1]: bats.append(f"R={lo[1]*100//14}%")
                                if len(lo) > 2 and lo[2]: bats.append(f"C={lo[2]*100//14}%")
                                if bats: detail = " " + ",".join(bats)
                            parts.append(f"{tname}{detail}")
                        apple_info = " | Apple: " + ", ".join(parts)

                    # RSSI delta
                    rssi_delta = ""
                    if self._prev_rssi is not None:
                        delta = rssi - self._prev_rssi
                        if delta != 0:
                            rssi_delta = f" ({delta:+d})"
                    self._prev_rssi = rssi

                    svc_str = f" Svc:[{','.join(services)}]" if services else ""
                    name_str = f' Name:"{name}"' if name else ""

                    entry = f"[dim]{now}[/]  {rssi}dBm{rssi_delta}{apple_info}{svc_str}{name_str}"
                    self.log_entries.append(entry)
                    self._update_display()

                try:
                    self._scanner = BleakScanner(callback)
                    await self._scanner.start()
                    await asyncio.sleep(300)  # 5 minutes max
                    await self._scanner.stop()
                except Exception as e:
                    self.log_entries.append(f"[red]Scanner error: {e}[/red]")
                    self._update_display()

            self.run_worker(_scan, exclusive=True, group="actionlog")

        def _update_display(self):
            try:
                widget = self.query_one("#log-entries")
                # Show last 100 entries
                visible = self.log_entries[-100:]
                widget.update("\n".join(visible))
                # Auto-scroll to bottom
                widget.scroll_end()
            except Exception:
                pass

        def action_close(self) -> None:
            if self._scanner:
                import asyncio
                try:
                    asyncio.get_event_loop().create_task(self._scanner.stop())
                except Exception:
                    pass
            self.dismiss()



                    self._classic_sec,
                    self._ble_sec,
                    self._classic_only,
                    self._ble_only,
                )
            except Exception as e:
                self._scanning = False
                self._update_status_bar(f"Scan error: {e}")
                return

            self._scanning = False
            self._tracker.update(devices)
            self._refresh_table()
            # Check for watched device alerts
            self._check_watched_devices(devices)
            self._update_status_bar()

        def _check_watched_devices(self, devices):
            """Check if any watched device appeared in scan results."""
            if not self._watched:
                return
            new_alerts = []
            for dev in devices:
                dev_id = dev["id"]
                if dev_id in self._watched:
                    name = dev.get("name") or dev.get("apple_identity") or dev_id[:12]
                    alert = f"⚠ Watched device appeared: {name} ({dev.get('rssi', '?')}dBm)"
                    new_alerts.append(alert)
                    # Send macOS notification
                    _send_notification(
                        "btradar Watch Alert",
                        f"{name} appeared at {dev.get('rssi', '?')}dBm"
                    )
            if new_alerts:
                self._watch_alerts = new_alerts[-5:]  # keep last 5
                alert_str = " │ ".join(self._watch_alerts)
                self._update_status_bar(alert_str)


def load_watched():
    """Load watched device IDs from JSON file."""
    watched_file = os.path.join(HISTORY_DB_DIR, "watched.json")
    if os.path.exists(watched_file):
        try:
            with open(watched_file) as f:
                data = json.load(f)
                return set(data.get("watched", []))
        except Exception:
            pass
    return set()


def save_watched(watched_set):
    """Save watched device IDs to JSON file."""
    watched_file = os.path.join(HISTORY_DB_DIR, "watched.json")
    os.makedirs(HISTORY_DB_DIR, exist_ok=True)
    with open(watched_file, "w") as f:
        json.dump({"watched": list(watched_set)}, f, indent=2)


def _send_notification(title, message):
    """Send macOS notification if terminal-notifier is available."""
    try:
        subprocess.Popen(
            ["terminal-notifier", "-title", title, "-message", message],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        pass



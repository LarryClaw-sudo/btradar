def signal_bar(rssi, width=10):
    """RSSI -> visual bar: \u2588\u2588\u2588\u2588\u2591\u2591\u2591\u2591\u2591\u2591 style."""
    if rssi is None:
        return "\u2591" * width
    bars = max(0, min(width, int((rssi + 100) / (100 / width))))
    filled = "\u2588" * bars
    empty = "\u2591" * (width - bars)
    return f"{filled}{empty}"


def rssi_color(rssi):
    """Color string based on signal strength."""
    if rssi is None:
        return "dim"
    if rssi >= -50:
        return "green"
    if rssi >= -70:
        return "yellow"
    return "red"


